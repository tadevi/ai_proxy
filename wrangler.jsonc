{
  "name": "ai-proxy",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  },
  "build": {
    "command": "pnpm --filter @gateway/web build"
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/v1",
      "/v1/*",
      "/anthropic",
      "/anthropic/*",
      "/health",
      "/__health",
      "/__db-health"
    ]
  }
}
