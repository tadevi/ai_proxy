{
  "name": "ai-proxy",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "build": {
    "command": "pnpm --filter @gateway/web build"
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/v1",
      "/v1/*",
      "/anthropic",
      "/anthropic/*",
      "/health",
      "/__health"
    ]
  }
}
